# Picasso Doodles — GoDaddy cPanel (Linux/Apache) hosting config
# Upload to public_html alongside index.html and admin.html.
#
# .htaccess is a hidden file. In cPanel File Manager turn on
# Settings > "Show Hidden Files (dotfiles)" or you won't see it.
#
# IMPORTANT: this file is written to be safe BEFORE picassodoodles.com
# has finished transferring from Wix. The rules below are host-agnostic:
# they work correctly on whatever domain is currently attached to the
# hosting. The block that forces one canonical domain is commented out
# and must stay that way until the transfer completes -- see PHASE 3.

RewriteEngine On

# ── Force HTTPS ──────────────────────────────────────────────────
# Host-agnostic: redirects to https on whatever domain was requested,
# so this is safe on picassodoodlesworldwide.com today and on
# picassodoodles.com later.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── Strip www ────────────────────────────────────────────────────
# Also host-agnostic: www.anything -> anything
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ── PHASE 3 ONLY — do not uncomment yet ──────────────────────────
# Uncomment these two lines ONLY after picassodoodles.com has fully
# transferred to GoDaddy and is attached to this hosting account.
# They send every other domain (picassodoodlesworldwide.com included)
# to picassodoodles.com with a permanent 301.
#
# Uncommenting early sends your visitors to a domain still parked on
# Wix, which is the one way to actually break the live site.
#
# RewriteCond %{HTTP_HOST} !^picassodoodles\.com$ [NC]
# RewriteRule ^(.*)$ https://picassodoodles.com/$1 [R=301,L]

# ── Default document ─────────────────────────────────────────────
DirectoryIndex index.html

# ── Don't list directory contents ────────────────────────────────
Options -Indexes

# ── Caching ──────────────────────────────────────────────────────
# HTML is never cached so republished edits appear immediately.
# Static assets cached for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Basic security headers ───────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
